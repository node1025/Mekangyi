# Leave empty for same-origin requests through the web gateway.
VITE_API_BASE_URL=

# 관리자 화면 경로 추측 방지 (운영 빌드에서 설정 권장)
# 예: VITE_ADMIN_ROUTE_ROOT=/bk-ops-7f3a9c2e
# → /bk-ops-7f3a9c2e/sign-in · /verify · /desk (기본 /login · /admin 은 로컬용)
# npm run admin:route-slug 로 랜덤 접두 생성 (--write 로 admin/.env 반영)
VITE_ADMIN_ROUTE_ROOT=
