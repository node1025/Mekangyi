PORT=5000
NODE_ENV=development
MARIADB_URI=mariadb://bukang:CHANGE_ME@127.0.0.1:3306/bukang_shop_demo
JWT_SECRET=
JWT_REFRESH_SECRET=
PORTONE_API_SECRET=
# 로컬 start-all 시 자동 true. 실제 PortOne 연동 시 server/.env에 시크릿을 넣고 LOCAL_PAYMENT_MODE=false
LOCAL_PAYMENT_MODE=true
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=


# Password reset mail (a real SMTP account is required).
# Use the frontend origin that opens the reset page; HTTPS is required in production.
FRONTEND_URL=http://localhost:5173
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Separate test database for seed:demo and admin:demo; database name must end with _demo.
DEMO_MARIADB_URI=mariadb://bukang:CHANGE_ME@127.0.0.1:3306/bukang_shop_demo

# Dedicated disposable database for integration tests (must end in _test_demo).
TEST_MARIADB_URI=

# Separate administrative site and trusted gateway peers.
ADMIN_FRONTEND_URL=http://localhost:8081
TRUSTED_PROXIES=127.0.0.1,::1
ADMIN_GATEWAY_PEERS=127.0.0.1,::1
SERVE_UPLOADS=false

# Local admin uploads without Cloudinary (also auto-enabled in development when Cloudinary is unset).
LOCAL_IMAGE_UPLOADS=true

# Local test mail only (NODE_ENV=development); use smtp with a real account for production.
RESET_MAIL_MODE=local

