PORT=5000
NODE_ENV=development
MARIADB_URI=mariadb://bukang:CHANGE_ME@127.0.0.1:3306/bukang_shop_dev
JWT_SECRET=
JWT_REFRESH_SECRET=
PORTONE_API_SECRET=
# 로컬 start-all 시 자동 true. 실제 PortOne 연동 시 server/.env에 시크릿을 넣고 LOCAL_PAYMENT_MODE=false
LOCAL_PAYMENT_MODE=true
# In AWS set IMAGE_STORAGE=s3, S3_IMAGE_BUCKET=mk-prod-shop-static-1223
IMAGE_STORAGE=local
S3_IMAGE_BUCKET=
AWS_REGION=ap-northeast-2

# RDS 등 SSL 필수 DB: CA 인증서 경로(권장) 또는 MARIADB_SSL=true(검증 생략)
MARIADB_SSL_CA=

# Password reset mail (a real SMTP account is required).
# Use the frontend origin that opens the reset page; HTTPS is required in production.
FRONTEND_URL=http://localhost:5173
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Development catalog DB for seed:dev and admin:dev; database name must end with _dev (not _test_dev).
DEV_MARIADB_URI=mariadb://bukang:CHANGE_ME@127.0.0.1:3306/bukang_shop_dev

# Dedicated disposable database for integration tests (must end in _test_dev).
TEST_MARIADB_URI=

# Separate administrative site and trusted gateway peers.
ADMIN_FRONTEND_URL=http://localhost:8081
TRUSTED_PROXIES=127.0.0.1,::1
ADMIN_GATEWAY_PEERS=127.0.0.1,::1
SERVE_UPLOADS=false

# Local image uploads are enabled only when IMAGE_STORAGE=local.

# Local test mail only (NODE_ENV=development); use smtp with a real account for production.
# RESET_MAIL_MODE=local saves reset links under server/.local-mail (no real SMTP).
# LOCAL_MAILBOX=1 with start-all opens the 8025 web viewer; default is off.
RESET_MAIL_MODE=local

